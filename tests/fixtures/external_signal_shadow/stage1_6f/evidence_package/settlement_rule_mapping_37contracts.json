    "authority_published_utc": "2024-11-04T09:00:00Z",
    "cutoff_boundary_utc": "2024-11-11T08:00:00Z",
    "cutoff_boundary_ms": 1731312000000,
    "pre_cutoff_rule_excerpt": "The settlement price used for delivery of contracts will be calculated as the average of the price index every second over the last hour (between 07:00 and 08:00 UTC) before delivery, i.e., a total of 3,600 price indices.",
    "post_cutoff_rule_excerpt": "It will use the average of the price index every second over the last 30 minutes (between 07:30 and 08:00 UTC) before delivery, i.e., a total of 1,800 price indices. Please note that the change will affect the settlement price calculation for both delivery contracts and any contracts that are subject to delisting."
